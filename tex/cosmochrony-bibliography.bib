@misc{Beau2026q7,
  author = {Beau, J\'er\^ome},
  title = {{Toward Three Spatial Directions from a Supplied Spinor Carrier: Requirements for an Equivariant Bridge}},
  year = {2026},
  note = {Q7 (version 2.0): states the requirements an equivariant bridge would have to meet and proves those that
 follow from representation theory on a supplied carrier; the identification of the measured space with the spin-one
